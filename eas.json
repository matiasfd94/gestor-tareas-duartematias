{
  "cli": {
    "version": ">= 27.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "profesor-development",
        "EXPO_PUBLIC_PROFESOR_API_URL": "https://backend-proyecto.n7softwares.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "profesor",
        "EXPO_PUBLIC_PROFESOR_API_URL": "https://backend-proyecto.n7softwares.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "development-profesor": {
      "extends": "development"
    },
    "preview-profesor": {
      "extends": "preview"
    }
  },
  "submit": {
    "production": {}
  }
}
